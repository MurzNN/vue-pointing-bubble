{
  "name": "vue-pointing-bubble",
  "version": "0.1.0",
  "description": "Vue 3 callout / speech bubble component whose tail points exactly at absolute (x, y) coordinates or at a DOM element.",
  "keywords": [
    "vue",
    "vue3",
    "callout",
    "speech-bubble",
    "tooltip",
    "popover",
    "pointer",
    "svg"
  ],
  "author": "Alexey Murz Korepov",
  "license": "MIT",
  "homepage": "https://murznn.github.io/vue-pointing-bubble/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurzNN/vue-pointing-bubble.git"
  },
  "bugs": {
    "url": "https://github.com/MurzNN/vue-pointing-bubble/issues"
  },
  "type": "module",
  "main": "./dist/vue-pointing-bubble.umd.cjs",
  "module": "./dist/vue-pointing-bubble.js",
  "unpkg": "./dist/vue-pointing-bubble.umd.cjs",
  "jsdelivr": "./dist/vue-pointing-bubble.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-pointing-bubble.js",
      "require": "./dist/vue-pointing-bubble.umd.cjs"
    },
    "./PointingBubble.vue": "./registry/ui/pointing-bubble/PointingBubble.vue"
  },
  "files": [
    "dist",
    "src",
    "registry"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "npm run dev:demo",
    "dev:demo": "vite --config vite.demo.config.js",
    "build": "vite build && cp src/index.d.ts dist/index.d.ts",
    "build:demo": "npm run registry:build && vite build --config vite.demo.config.js",
    "registry:build": "shadcn-vue build --output demo/public/r",
    "preview:demo": "vite preview --config vite.demo.config.js",
    "test": "playwright test",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "shadcn-vue": "^2.8.2",
    "vite": "^8.3.2",
    "vue": "^3.5.43"
  }
}
